require 'rbconfig'

# Detect if the host machine is Apple Silicon (ARM64)
is_apple_silicon = RbConfig::CONFIG['host_os'] =~ /darwin/ && RbConfig::CONFIG['host_cpu'] =~ /arm|aarch64/

# If on Apple Silicon, force Vagrant to abandon VirtualBox and use VMware
if is_apple_silicon
  ENV['VAGRANT_DEFAULT_PROVIDER'] = 'vmware_desktop'
end

Vagrant.configure("2") do |config|
  # bento/ubuntu-22.04 publishes both amd64 (VirtualBox) and arm64 (VMware)
  # builds under one box name — Vagrant auto-matches your host architecture.
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.hostname = "WidgetCorp-Web"

  # Assign a static IP on a private network
  config.vm.network "private_network", ip: "192.168.56.10"

  # Use 'ansible_local' to install and run Ansible INSIDE the VM.
  # Challenge scripts now live in scripts/, per repo convention.
  config.vm.provision "ansible_local" do |ansible|
    ansible.playbook = "scripts/break_server.yml"
    ansible.become = true
  end

  # --- Provider Configurations ---

  # 1. VirtualBox (For Windows, Linux, and Intel Macs)
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
    vb.cpus = 1
  end

  # 2. VMware Fusion (Free alternative for Apple Silicon Macs)
  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["memsize"] = "1024"
    vmware.vmx["numvcpus"] = "1"
    # Skips the "unverified VM" prompt/block on first run
    vmware.allowlist_verified = true
  end
end